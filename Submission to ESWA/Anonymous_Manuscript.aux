\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Subjective Logic Opinion Mapping \& Partial Projection Pipeline.} Bijective transformation from Dirichlet evidence parameters $\boldsymbol  {\alpha } = (\alpha _1, \alpha _2, \alpha _3, \alpha _4)$ onto opinion tuple $\omega = (\mathbf  {b}, u, \mathbf  {a})$ and projected expected probability $P(x_k) = b_k + a_k \cdot u$. When a modality drops, the partial-observable projection rule ($\alpha _k^{\text  {proj}} = C \cdot a_k$) forces belief mass $b_k \to 0$ and raises epistemic uncertainty $u \to 1.0$ monotonically.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:opinion_pipeline}{{1}{5}{\textbf {Subjective Logic Opinion Mapping \& Partial Projection Pipeline.} Bijective transformation from Dirichlet evidence parameters $\boldsymbol {\alpha } = (\alpha _1, \alpha _2, \alpha _3, \alpha _4)$ onto opinion tuple $\omega = (\mathbf {b}, u, \mathbf {a})$ and projected expected probability $P(x_k) = b_k + a_k \cdot u$. When a modality drops, the partial-observable projection rule ($\alpha _k^{\text {proj}} = C \cdot a_k$) forces belief mass $b_k \to 0$ and raises epistemic uncertainty $u \to 1.0$ monotonically}{figure.1}{}}
\newlabel{fig:opinion_pipeline@cref}{{[figure][1][]1}{[1][3][]5}}
