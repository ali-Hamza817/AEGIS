\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Monotonic Epistemic Uncertainty $u$ Under Sensor Dropout (H3).} Distribution of cell-wise $u$ values across 0, 1, 2, and 3 dropped modalities. Mean $u$ (red overlay) rises strictly monotonically ($0.12 \to 0.34 \to 0.61 \to 0.83$) without false-confidence subtraction, verifying Theorem 1.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:monotonic_u_progression}{{6}{11}{\textbf {Monotonic Epistemic Uncertainty $u$ Under Sensor Dropout (H3).} Distribution of cell-wise $u$ values across 0, 1, 2, and 3 dropped modalities. Mean $u$ (red overlay) rises strictly monotonically ($0.12 \to 0.34 \to 0.61 \to 0.83$) without false-confidence subtraction, verifying Theorem 1}{figure.6}{}}
\newlabel{fig:monotonic_u_progression@cref}{{[figure][6][]6}{[1][8][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {24-Day Per-Agent Credibility Trajectory \& Online Convergence (H4 Part 1).} Online Brier-score reputation update ($\gamma _i \in [0.10, 1.0]$) for five specialist agents starting from neutral $\gamma _0=0.50$. All agents converge within the initial 7-day window to stable reputation scores.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:agent_credibility_trajectory}{{7}{11}{\textbf {24-Day Per-Agent Credibility Trajectory \& Online Convergence (H4 Part 1).} Online Brier-score reputation update ($\gamma _i \in [0.10, 1.0]$) for five specialist agents starting from neutral $\gamma _0=0.50$. All agents converge within the initial 7-day window to stable reputation scores}{figure.7}{}}
